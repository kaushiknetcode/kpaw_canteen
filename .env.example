# Copy this file to .env and fill in your real Hostinger credentials.
# .env itself must NEVER be committed to Git — it's in .gitignore already.

DB_HOST=localhost
DB_NAME=your_hostinger_db_name
DB_USER=your_hostinger_db_user
DB_PASS=your_hostinger_db_password

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_smtp_password
# ^ Not currently used — kept for future reference only.

GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# ^ Actually used for sending OTP/reset emails via Gmail SMTP.
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
# (requires 2-Step Verification turned on for that Gmail account first)
